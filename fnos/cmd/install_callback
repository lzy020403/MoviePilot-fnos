#!/bin/bash
# Keep install fast: only verify payload + bundled Python and prepare dirs.
# Heavy deps/frontend install happens on first start (see cmd/main).

LOG_FILE="${TRIM_PKGVAR:-/tmp}/install.log"
APP_DIR="${TRIM_APPDEST}/server"
RUNTIME_BIN="${TRIM_APPDEST}/runtime/python/bin"
PYTHON_BIN="${RUNTIME_BIN}/python3"

mkdir -p "${TRIM_PKGVAR:-/tmp}" 2>/dev/null || true

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null || true
}

if [ ! -x "${PYTHON_BIN}" ]; then
  msg="Bundled Python missing at ${PYTHON_BIN}"
  log_msg "${msg}"
  echo "${msg}" > "${TRIM_TEMP_LOGFILE:-/tmp/moviepilot-install.err}"
  exit 1
fi

if [ ! -f "${APP_DIR}/pyproject.toml" ] || [ ! -x "${APP_DIR}/moviepilot" ]; then
  msg="MoviePilot server payload missing under ${APP_DIR}"
  log_msg "${msg}"
  echo "${msg}" > "${TRIM_TEMP_LOGFILE:-/tmp/moviepilot-install.err}"
  exit 1
fi

# data-share paths may be empty during some install phases
SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}"
CONFIG_DIR="${SHARE_PATHS%%:*}"
if [ -z "${CONFIG_DIR}" ] || [ "${CONFIG_DIR}" = "${SHARE_PATHS}" ]; then
  # single path or empty
  if [ -n "${SHARE_PATHS}" ] && [ "${SHARE_PATHS#*:}" = "${SHARE_PATHS}" ]; then
    CONFIG_DIR="${SHARE_PATHS}"
    CORE_DIR="${TRIM_PKGVAR:-/tmp}/core"
  else
    CONFIG_DIR="${TRIM_PKGVAR:-/tmp}/config"
    CORE_DIR="${TRIM_PKGVAR:-/tmp}/core"
  fi
else
  REST="${SHARE_PATHS#*:}"
  CORE_DIR="${REST%%:*}"
fi
[ -z "${CORE_DIR}" ] && CORE_DIR="${TRIM_PKGVAR:-/tmp}/core"

mkdir -p "${CONFIG_DIR}" "${CORE_DIR}" 2>/dev/null || true
chmod +x "${APP_DIR}/moviepilot" 2>/dev/null || true
chmod +x "${PYTHON_BIN}" 2>/dev/null || true
chmod -R a+rX "${TRIM_APPDEST}/runtime/python" 2>/dev/null || true

cat > "${APP_DIR}/.moviepilot.env" <<EOF
CONFIG_DIR=${CONFIG_DIR}
MOVIEPILOT_CONFIG_DIR=${CONFIG_DIR}
CLOAKBROWSER_CACHE_DIR=${CORE_DIR}
NGINX_PORT=${TRIM_SERVICE_PORT:-3000}
PORT=${MOVIEPILOT_API_PORT:-3001}
TZ=${TZ:-Asia/Shanghai}
EOF

# Mark that bootstrap is still needed on first start.
touch "${TRIM_PKGVAR:-/tmp}/needs_bootstrap" 2>/dev/null || true
log_msg "Install callback OK (python=$("${PYTHON_BIN}" --version 2>&1)); deps deferred to first start"
exit 0
